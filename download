-- ---------- SEED: SPACES (180 addresses, generated deterministically) ----------
-- 6 streets x 30 units. Status/tenant/category derived from a stable hash of the
-- address, so re-running yields the same map. The database is the source of truth;
-- leasing flips a space to 'leased' via the Stripe webhook.
with s(street) as (
  values ('The Runway'),('The Hangar'),('Takeoff Lane'),('Ascend Avenue'),('First Class Row'),('Founders Way')
),
cats(cat, cidx) as (
  values ('Food & Drink',0),('Retail',1),('Services',2),('Tech',3),('Beauty',4),
         ('Fitness',5),('Auto',6),('Creative',7),('Home',8),('Finance',9)
),
firsts(nm, fidx) as (
  values ('Meridian',0),('Copper',1),('Vertex',2),('Halcyon',3),('Aurelio',4),
         ('Nova',5),('Summit',6),('Ironwood',7),('Marlowe',8),('Kestrel',9),
         ('Juniper',10),('Atlas',11),('Beacon',12),('Onyx',13),('Sage',14),
         ('Harbor',15),('Lumen',16),('Cobalt',17),('Anchor',18),('Cardinal',19)
),
sufs(sfx, sfidx) as (
  values ('Coffee',0),('& Co.',1),('Studio',2),('Labs',3),('Salon',4),
         ('Athletic',5),('Motors',6),('Press',7),('Home',8),('Capital',9)
),
donated(dn, didx) as (
  values ('Zoe''s Bakeshop',0),('Kayden Customs',1),('Bloom by Amara',2),('Deveny Reads',3),
         ('Nova Skate',4),('Milo''s Lemonade',5),('Ava Makes',6),('Bright Start Crafts',7)
),
grid as (
  select s.street, g,
         100 + (g/2)*2 as num,
         case when g % 2 = 0 then 'A' else 'B' end as unit,
         (('x'||substr(md5(s.street||'-'||g::text),1,8))::bit(32)::int & 2147483647) as h
  from s cross join generate_series(0,29) as g
)
insert into public.spaces (street, num, unit, status, tenant_name, category)
select street, num, unit,
  case when h % 100 < 9 then 'liftoff' when h % 100 < 42 then 'leased' else 'open' end,
  case
    when h % 100 < 9  then (select dn from donated where didx = (h/11) % 8)
    when h % 100 < 42 then (select nm from firsts where fidx = (h/7) % 20) || ' ' || (select sfx from sufs where sfidx = (h/13) % 10)
    else null end,
  case when h % 100 < 42 then (select cat from cats where cidx = (h/3) % 10) else null end
from grid;
